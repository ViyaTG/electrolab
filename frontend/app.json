{
  "expo": {
    "name": "Inventario Electrónica",
    "slug": "inventario-electronica-mvp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F1F1F3"
    },
    "android": {
      "permissions": [
        "INTERNET"
      ],
      "package": "com.laboratorio.inventarioelectronica",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1F1F3"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laboratorio.inventarioelectronica"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4c978474-cff9-4b60-b144-c40fb5bad21d"
      }
    },
    "owner": "viyatg"
  }
}
