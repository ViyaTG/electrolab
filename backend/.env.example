# Configuración del Servidor y Base de Datos
MONGODB_URI=TU_LINK_AQUI
PORT=4000
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SECRETA_LARGA_Y_ALEATORIA
NODE_ENV=development

# Gmail: completa SMTP_USER y SMTP_PASS cuando crees la cuenta.
# SMTP_PASS es una contraseña de aplicación de Google, no la contraseña habitual.
# Mientras no configures Gmail, puedes vaciar SMTP_HOST para imprimir códigos en desarrollo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ES

# Desarrollo: smtp. Render gratuito: brevo (HTTPS).
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ES
